# ===== Ứng dụng =====
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173

# ===== Database (MySQL) =====
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=tour_management
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ===== JWT =====
# Bắt buộc đổi ở môi trường thật: `openssl rand -hex 48`
JWT_SECRET=doi_secret_nay_thanh_chuoi_ngau_nhien_dai
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=doi_refresh_secret_nay_thanh_chuoi_ngau_nhien_dai
JWT_REFRESH_EXPIRES_IN=7d

# ===== Thanh toán (cổng giả lập) =====
# Khóa HMAC để ký webhook giả lập: HMAC-SHA256(txnRef|gatewayTxnNo|amount|1|0)
PAYMENT_MOCK_SECRET=mock-secret
# Hạn thanh toán (phút) tính từ lúc tạo phiên
PAYMENT_TTL_MINUTES=15
# Dùng để dựng URL thanh toán giả lập trả về cho client
APP_PUBLIC_URL=http://localhost:3000

# ===== Tải tệp (UploadModule) =====
# Thư mục lưu tệp, tính từ thư mục chạy backend. Phục vụ công khai tại /uploads/*
UPLOAD_DIR=uploads
# Tiền tố domain để dựng URL tuyệt đối trả cho client (bỏ trống = dùng URL tương đối)
PUBLIC_BASE_URL=http://localhost:3000

# ===== Định dạng response =====
# true = bọc mọi response thành công vào { success, statusCode, data, ... }
# Giữ false nếu frontend hiện tại đang đọc payload trực tiếp.
RESPONSE_ENVELOPE=false

# ===== Seed (npm run db:seed) =====
ADMIN_EMAIL=admin@tour.local
ADMIN_PASSWORD=Admin@123456
ADMIN_FULL_NAME=Quản trị viên
