# ===== Ứng dụng =====
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# ===== Database (MySQL) =====
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=tour_management
DB_SYNCHRONIZE=false
DB_LOGGING=false
# Bật khi dùng database cloud. Chứng chỉ luôn được xác minh.
DB_SSL=false
# PEM CA tùy chọn, hỗ trợ ký tự xuống dòng dạng \n.
DB_SSL_CA=

# ===== JWT =====
# Bắt buộc đổi ở môi trường thật: `openssl rand -hex 48`
JWT_SECRET=doi_secret_nay_thanh_chuoi_ngau_nhien_dai
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=doi_refresh_secret_nay_thanh_chuoi_ngau_nhien_dai
JWT_REFRESH_EXPIRES_IN=7d

# ===== Thanh toán (cổng giả lập) =====
# Khóa HMAC để ký webhook giả lập: HMAC-SHA256(txnRef|gatewayTxnNo|amount|1|0)
PAYMENT_MOCK_SECRET=mock-secret
# Hạn thanh toán (phút) tính từ lúc tạo phiên
PAYMENT_TTL_MINUTES=15
# Dùng để dựng URL thanh toán giả lập trả về cho client
APP_PUBLIC_URL=http://localhost:3000

# ===== Tải tệp (UploadModule) =====
# Thư mục lưu tệp, tính từ thư mục chạy backend. Phục vụ công khai tại /uploads/*
UPLOAD_DIR=uploads
# local khi phát triển; cloudinary khi deploy lên Render Free.
UPLOAD_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Tiền tố domain để dựng URL tuyệt đối trả cho client (bỏ trống = dùng URL tương đối)
PUBLIC_BASE_URL=http://localhost:3000

# ===== Định dạng response =====
# true = bọc mọi response thành công vào { success, statusCode, data, ... }
# Giữ false nếu frontend hiện tại đang đọc payload trực tiếp.
RESPONSE_ENVELOPE=false

# ===== Seed (npm run db:seed) =====
ADMIN_EMAIL=admin@tour.local
ADMIN_PASSWORD=Admin@123456
ADMIN_FULL_NAME=Quản trị viên

# ===== Email xác nhận thanh toán =====
# Thư được lưu vào DB cùng giao dịch thanh toán; gửi nền mỗi 10 giây.
# Khi false, thư chờ được giữ nguyên, không giả lập trạng thái đã gửi.
MAIL_ENABLED=false
MAIL_FROM="TourGo <billing@example.com>"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
# SMTP cục bộ (Mailpit): port 1025, SMTP_REQUIRE_TLS=false, bỏ user/password.

# Thông tin đơn vị được chụp vào hóa đơn lúc phát hành
INVOICE_SELLER_NAME=TourGo
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_EMAIL=
INVOICE_SELLER_PHONE=
